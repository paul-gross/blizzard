# Copy to .env (beside compose.yaml) and edit before `docker compose up`.

# The site Caddy serves. A real DNS name pointed at this host gets automatic
# HTTPS (a cert minted and renewed with no extra config) — put the domain here.
# Leave at :80 for a localhost-only evaluation profile with no TLS.
BLIZZARD_SITE_ADDRESS=:80

# Host ports Caddy publishes. Change only if 80/443 are already taken on this host.
BLIZZARD_HTTP_PORT=80
BLIZZARD_HTTPS_PORT=443

# The hub image to run. Defaults to the published GHCR tag (issue #189); until
# the first publish, or to evaluate a local build, override to a locally-built
# tag instead — from the repo root: `mise run build` (populates dist/), then
# `docker build -f packaging/docker/Dockerfile -t blizzard-hub:local .`, then
# BLIZZARD_HUB_IMAGE=blizzard-hub:local.
BLIZZARD_HUB_IMAGE=ghcr.io/paul-gross/blizzard-hub:latest

# Postgres credentials — the hub's BZ_HUB_DB_URL (compose.yaml) is derived from
# these. Change POSTGRES_PASSWORD before any non-evaluation use.
POSTGRES_USER=blizzard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blizzard
