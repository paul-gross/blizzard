# The blizzard-runner daemon — the supervisor: the stateless REAP -> PULL -> FILL
# -> ADVANCE reconciliation loop behind a local API (glossary "supervisor").
# Installed as the runner half of the colocated
# single-machine pair; the hub half is
# blizzard-hub.service. Setup + the reboot-recovery contract: docs/deployment.md.
[Unit]
Description=Blizzard runner — the supervisor loop + local API (blizzard-runner)
Documentation=https://github.com/paul-gross/blizzard/blob/master/docs/deployment.md
# Colocated ordering: prefer the hub up first, but the runner reaches the hub
# outbound-only and keeps working while the hub is unreachable,
# so this is a convenience, not a hard dependency.
After=network-online.target blizzard-hub.service
Wants=network-online.target

[Service]
Type=exec
# Offline schema reconcile before the daemon opens the store; the daemon
# refuses to start on a revision mismatch. Self-healing across a wheel upgrade.
ExecStartPre=/opt/blizzard/venv/bin/blizzard-runner migrate --dir /var/lib/blizzard/runner
ExecStart=/opt/blizzard/venv/bin/blizzard-runner host --dir /var/lib/blizzard/runner
# Optional overrides (workspace root, hub URL, harness binary) — the durable ones
# live in the runner's own config.toml, seeded by `blizzard runner init`. No forge
# or work-source credentials belong here: a runner never holds them.
EnvironmentFile=-/etc/blizzard/runner.env
User=blizzard
Group=blizzard
# Shares /var/lib/blizzard with the hub unit; runner state lives under runner/.
StateDirectory=blizzard
WorkingDirectory=/var/lib/blizzard/runner
# The reboot/crash-recovery mechanism (docs/deployment.md): after a kill -9 or a
# machine reboot, systemd brings the supervisor back and its FIRST tick is REAP —
# it reaps the leases stranded by the crash, re-reads its environment bindings from
# the store, and continues each chunk at the node the hub last recorded; nothing is
# worked twice (proven by tests/crash/test_kill9_sweep.py::test_kill9_runner_daemon_after_session_end).
#
# A GRACEFUL restart (`systemctl restart`, or stop→start on a wheel upgrade) is stronger:
# the SIGTERM lets the daemon run its shutdown path, which marks every in-flight lease with
# a durable resume-intent, then drains its own workers: SIGINT each marked lease's process
# group, wait up to 60s total (one shared budget, not 60s each), SIGKILL whatever is still
# alive. Claude Code answers SIGINT with an `error_during_execution` envelope that still
# carries a real `total_cost_usd`, so an interrupted invocation's spend is recorded, not
# lost to the NULL-cost fallback. Its first startup tick then RESUMEs each marked session
# in place — same lease/epoch/session, only the pid rewritten, no retry consumed — so
# adopting a newly-merged runner build no longer discards in-flight agent context. A
# `kill -9` during the re-attach itself still degrades to the ordinary crash contract above
# (REAP requeues) — the recovery boundaries are the crash-point sweep's, not a stronger
# claim than it arms; see steps.py `_resume_in_place`.
#
# KillMode=mixed: systemd signals only the daemon itself on stop, never the workers in its
# cgroup — the drain above is the one and only thing that ever signals a worker. Under the
# default `control-group` mode systemd would SIGTERM every worker alongside the daemon,
# racing the drain's own SIGINT and losing the real-cost envelope the drain exists for.
# TimeoutStopSec=120 covers the 60s drain budget plus the rest of an orderly shutdown
# (the unbounded loop-thread join, the outbound buffer's last flush); past it systemd
# SIGKILLs the whole cgroup, the same NULL-cost outcome a SIGKILLed worker already has.
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
