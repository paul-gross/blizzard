{
  "daemon": "host",
  "env": {
    "atomic": true,
    "file": ".env",
    "mode": "0600",
    "variables": [
      {
        "holds": "the host's one host token",
        "name": "BZ_HOST_TOKEN",
        "name_rule": null
      },
      {
        "holds": "one runner's hub token, by runner name",
        "name": "BZ_HUB_TOKEN_<NAME>",
        "name_rule": {
          "prefix": "BZ_HUB_TOKEN_",
          "replace_pattern": "[^A-Z0-9]",
